{
  "name": "music-ball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把一首 mp3 变成「球踩节拍逐级撞板下落」的霓虹动画，并导出 mp4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "testtrack": "node --experimental-strip-types scripts/make-testtrack.mts",
    "pianotrack": "node --experimental-strip-types scripts/make-piano.mts && node --experimental-strip-types scripts/make-piano-expressive.mts",
    "verify": "node --experimental-strip-types scripts/verify.mts",
    "verify:note": "node --experimental-strip-types scripts/verify-note.mts",
    "verify:note:real": "node --experimental-strip-types scripts/verify-note.mts --real",
    "verify:speed": "node --experimental-strip-types scripts/verify-speed.mts",
    "verify:bead": "node --experimental-strip-types scripts/verify-bead.mts",
    "verify:scene": "node --experimental-strip-types scripts/verify-scene.mts",
    "bead:fixture": "node --experimental-strip-types scripts/bead-fixture.mts",
    "bead:plot": "node --experimental-strip-types scripts/bead-plot.mts",
    "bead:render": "node --experimental-strip-types scripts/render-bead.mts",
    "render": "node --experimental-strip-types scripts/render-video.mts",
    "copy:model": "mkdir -p public/models/basic-pitch && cp node_modules/@spotify/basic-pitch/model/* public/models/basic-pitch/",
    "predev": "npm run copy:model",
    "prebuild": "npm run copy:model"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.62.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "mediabunny": "^1.62.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
